

// ── Carnet canino ──────────────────────────────────────────────────────────────
// Se genera una vez por combinación nombre+propietario.
// Si ya existe, se devuelve el mismo.

model Carnet {
  id           Int      @id @default(autoincrement())
  carnetId     String   @unique  // "MC-XXXXXX" generado automáticamente
  nombrePerro  String
  raza         String?
  edad         String?
  propietario  String?
  peso         String?
  color        String?
  sintomas     Json?    // array de strings guardado como JSON
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([nombrePerro, propietario]) // búsqueda rápida para saber si ya existe
}

// ── Productos de la tienda ─────────────────────────────────────────────────────
// Se actualiza constantemente desde el panel admin.

model Producto {
  id          Int              @id @default(autoincrement())
  nombre      String
  descripcion String           @db.Text
  categoria   CategoriaProducto
  precio      Float
  imagen      String?          // URL de la imagen (Cloudinary, etc.)
  stock       Int              @default(0)
  disponible  Boolean          @default(true)
  urgencia    UrgenciaProducto @default(media)
  creadoEn    DateTime         @default(now())
  actualizadoEn DateTime       @updatedAt

  reservaItems ReservaItem[]

  @@index([categoria])
  @@index([disponible])
}

// ── Reservas ───────────────────────────────────────────────────────────────────
// Cuando el usuario elige productos y hace clic en WhatsApp.

model Reserva {
  id          Int           @id @default(autoincrement())
  nombrePerro String?
  propietario String?
  items       ReservaItem[]
  estado      EstadoReserva @default(pendiente)
  creadoEn    DateTime      @default(now())
}

model ReservaItem {
  id         Int      @id @default(autoincrement())
  reserva    Reserva  @relation(fields: [reservaId], references: [id])
  reservaId  Int
  producto   Producto @relation(fields: [productoId], references: [id])
  productoId Int
  cantidad   Int      @default(1)
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum CategoriaProducto {
  medicamento
  alimento
  accesorio
}

enum UrgenciaProducto {
  alta
  media
  baja
}

enum EstadoReserva {
  pendiente
  confirmada
  cancelada
}
